import pygame
from pygame import *
import random

# Ініціалізація
pygame.init()
font.init()

win_width, win_height = 700, 500
window = display.set_mode((win_width, win_height))
display.set_caption("Space Battle: Rapid Fire")
clock = time.Clock()

font_main = font.SysFont('Arial', 24)
font_big = font.SysFont('Arial', 70)

# Кольори
GREEN = (0, 255, 0)
RED = (255, 0, 0)
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

class GameSprite(sprite.Sprite):
    def __init__(self, img, x, y, w, h, speed):
        super().__init__()
        try:
            self.image = transform.scale(image.load(img), (w, h))
        except:
            self.image = Surface((w, h))
            self.image.fill((200, 200, 0))
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.speed = speed

    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def __init__(self, img, x, y, w, h, speed):
        super().__init__(img, x, y, w, h, speed)
        self.hp = 5
        self.points = 0

    def update(self):
        keys = key.get_pressed()
        if keys[K_a] and self.rect.x > 5:
            self.rect.x -= self.speed
        if keys[K_d] and self.rect.x < win_width - self.rect.width:
            self.rect.x += self.speed
            
    def fire(self):
        bullet = Bullet('bullet.png', self.rect.centerx - 7, self.rect.top, 15, 20, -10)
        player_bullets.add(bullet)

class Enemy(GameSprite):
    def __init__(self, img, x, y, w, h, speed):
        super().__init__(img, x, y, w, h, speed)
        self.max_hp = random.randint(5, 7)
        self.hp = self.max_hp

    def update(self):
        self.rect.x += self.speed
        if self.rect.x > win_width - self.rect.width or self.rect.x < 0:
            self.speed *= -1

class Bullet(GameSprite):
    def update(self):
        self.rect.y += self.speed
        if self.rect.y < -20 or self.rect.y > win_height + 20:
            self.kill()

def draw_hp_bar(x, y, current_hp, max_hp):
    bar_width = 70
    fill = (current_hp / max_hp) * bar_width
    outline_rect = Rect(x, y, bar_width, 8)
    fill_rect = Rect(x, y, fill, 8)
    draw.rect(window, RED, outline_rect)
    draw.rect(window, GREEN, fill_rect)

# Об'єкти
player = Player('rocket.png', 320, 400, 60, 60, 7)
enemy = Enemy('ufo.png', 100, 50, 60, 60, 4)
player_bullets = sprite.Group()
enemy_bullets = sprite.Group()

last_enemy_shot = time.get_ticks()
finish = False
run = True

while run:
    for e in event.get():
        if e.type == QUIT:
            run = False
        if e.type == KEYDOWN:
            if e.key == K_SPACE and not finish:
                player.fire()
            if finish:
                if e.key == K_r:
                    player.hp = 5
                    player.points = 0
                    player.rect.x = 320
                    enemy.max_hp = random.randint(5, 7)
                    enemy.hp = enemy.max_hp
                    player_bullets.empty()
                    enemy_bullets.empty()
                    finish = False
                if e.key == K_q:
                    run = False

    if not finish:
        window.fill((30, 30, 40))
        player.update()
        enemy.update()
        player_bullets.update()
        enemy_bullets.update()

        # ШВИДКА СТРІЛЬБА ВОРОГА
        # Змінено затримку на 500мс (півсекунди)
        if time.get_ticks() - last_enemy_shot > 500: 
            bull = Bullet('bullet.png', enemy.rect.centerx - 7, enemy.rect.bottom, 15, 20, 8)
            enemy_bullets.add(bull)
            last_enemy_shot = time.get_ticks()

        # Коллізії
        if sprite.spritecollide(enemy, player_bullets, True):
            enemy.hp -= 1
            if enemy.hp <= 0:
                player.points += 1
                enemy.max_hp = random.randint(5, 7)
                enemy.hp = enemy.max_hp
                enemy.rect.x = random.randint(0, win_width - 60)

        if sprite.spritecollide(player, enemy_bullets, True):
            player.hp -= 1
            if player.hp <= 0:
                finish = True

        player_bullets.draw(window)
        enemy_bullets.draw(window)
        player.reset()
        enemy.reset()
        
        draw_hp_bar(player.rect.x, player.rect.y + 65, player.hp, 5)
        draw_hp_bar(enemy.rect.x, enemy.rect.y - 15, enemy.hp, enemy.max_hp)
        
        window.blit(font_main.render(f"Очки: {player.points}", True, WHITE), (10, 10))
    else:
        window.fill(BLACK)
        window.blit(font_big.render("GAME OVER", True, RED), (win_width//2 - 180, win_height//2 - 80))
        window.blit(font_main.render(f"Рахунок: {player.points}", True, WHITE), (win_width//2 - 60, win_height//2 + 10))
        window.blit(font_main.render("R - Рестарт | Q - Вихід", True, GREEN), (win_width//2 - 130, win_height//2 + 60))

    display.update()
    clock.tick(60)

pygame.quit()
