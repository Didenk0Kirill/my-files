import pygame
import random

pygame.init()

win_width = 600
win_height = 450
win = pygame.display.set_mode((win_width, win_height))
pygame.display.set_caption("Space Battle - PR19")

bg = pygame.image.load('bg.jpg')
bg = pygame.transform.scale(bg, (win_width, win_height))

player_img = pygame.image.load('spaceship.png').convert_alpha()
player_img = pygame.transform.scale(player_img, (50, 50))

meteor_img = pygame.image.load('meteorite.png').convert_alpha()
meteor_img = pygame.transform.scale(meteor_img, (30, 30))

asteroid_img = pygame.image.load('asteroid.png').convert_alpha()
asteroid_img = pygame.transform.scale(asteroid_img, (70, 70))

score = 0
font = pygame.font.SysFont('arial', 26, True)

class Player:
    def __init__(self, x, y, width, height, img):
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.img = img
        self.vel = 7
        self.hitbox = (self.x, self.y, self.width, self.height)

    def draw(self, win):
        win.blit(self.img, (self.x, self.y))
        self.hitbox = (self.x, self.y, self.width, self.height)

class Bullet:
    def __init__(self, x, y, radius, color):
        self.x = x
        self.y = y
        self.radius = radius
        self.color = color
        self.vel = 10

    def draw(self, win):
        pygame.draw.circle(win, self.color, (self.x, self.y), self.radius)

class Meteor:
    def __init__(self, x, y, width, height, img):
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.img = img
        self.vel = random.randint(4, 7)
        self.hp = 2
        self.hitbox = (self.x, self.y, self.width, self.height)

    def draw(self, win):
        self.move()
        win.blit(self.img, (self.x, self.y))
        self.hitbox = (self.x, self.y, self.width, self.height)

    def move(self):
        if self.y < win_height:
            self.y += self.vel
        else:
            self.respawn()

    def respawn(self):
        self.y = -50
        self.x = random.randint(0, win_width - self.width)
        self.hp = 2

class Asteroid:
    def __init__(self, x, y, width, height, img):
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.img = img
        self.vel = random.randint(2, 4)
        self.hp = 5
        self.hitbox = (self.x, self.y, self.width, self.height)

    def draw(self, win):
        self.move()
        win.blit(self.img, (self.x, self.y))
        self.hitbox = (self.x, self.y, self.width, self.height)

    def move(self):
        if self.y < win_height:
            self.y += self.vel
        else:
            self.respawn()
            
    def respawn(self):
        self.y = -100
        self.x = random.randint(0, win_width - self.width)
        self.hp = 5

def redrawGameWindow():
    win.blit(bg, (0, 0))
    score_text = font.render("Очки: " + str(score), 1, (255, 255, 255))
    win.blit(score_text, (10, 10))
    
    ship.draw(win)
    m1.draw(win)
    a1.draw(win)
    for bullet in bullets:
        bullet.draw(win)
    pygame.display.update()

ship = Player(275, 380, 50, 50, player_img)
m1 = Meteor(random.randint(0, 570), -50, 30, 30, meteor_img)
a1 = Asteroid(random.randint(0, 530), -150, 70, 70, asteroid_img)
bullets = []
shoot_loop = 0

run = True
while run:
    pygame.time.delay(30)
    
    if shoot_loop > 0:
        shoot_loop += 1
    if shoot_loop > 10:
        shoot_loop = 0

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            run = False

    for enemy in [m1, a1]:
        if (enemy.hitbox[1] + enemy.hitbox[3] > ship.hitbox[1] and 
            enemy.hitbox[1] < ship.hitbox[1] + ship.hitbox[3]):
            if (enemy.hitbox[0] + enemy.hitbox[2] > ship.hitbox[0] and 
                enemy.hitbox[0] < ship.hitbox[0] + ship.hitbox[2]):
                run = False 

    for bullet in bullets[:]:
        if (bullet.y < m1.hitbox[1] + m1.hitbox[3] and bullet.y > m1.hitbox[1]):
            if (bullet.x > m1.hitbox[0] and bullet.x < m1.hitbox[0] + m1.hitbox[2]):
                m1.hp -= 1
                bullets.remove(bullet)
                if m1.hp <= 0:
                    score += 15
                    m1.respawn()
                continue

        if (bullet.y < a1.hitbox[1] + a1.hitbox[3] and bullet.y > a1.hitbox[1]):
            if (bullet.x > a1.hitbox[0] and bullet.x < a1.hitbox[0] + a1.hitbox[2]):
                a1.hp -= 1
                bullets.remove(bullet)
                if a1.hp <= 0:
                    score += 5
                    a1.respawn()
                continue

        if bullet.y > 0:
            bullet.y -= bullet.vel
        else:
            bullets.remove(bullet)

    keys = pygame.key.get_pressed()
    
    if (keys[pygame.K_SPACE] or keys[pygame.K_f]) and shoot_loop == 0:
        bullets.append(Bullet(ship.x + ship.width // 2, ship.y, 5, (255, 255, 0)))
        shoot_loop = 1

    if keys[pygame.K_LEFT] and ship.x > 0:
        ship.x -= ship.vel
    if keys[pygame.K_RIGHT] and ship.x < win_width - ship.width:
        ship.x += ship.vel

    redrawGameWindow()

pygame.quit()
