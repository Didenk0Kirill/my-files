import pygame

pygame.init()

win_width = 500
win_height = 480
win = pygame.display.set_mode((win_width, win_height))
pygame.display.set_caption("PR 13-17: Goblin Respawn")

bg = pygame.image.load('bg.jpg')
bg = pygame.transform.scale(bg, (win_width, win_height))

class Player:
    def __init__(self, x, y, width, height):
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.vel = 5
        self.hitbox = (self.x + 10, self.y + 10, 40, 40)

    def draw(self, win):
        pygame.draw.rect(win, (0, 255, 0), (self.x, self.y, self.width, self.height))
        self.hitbox = (self.x + 10, self.y + 10, 40, 40)

class Enemy:
    def __init__(self, x, y, width, height, end):
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.end = end
        self.path = [self.x, self.end]
        self.vel = 3
        self.health = 10
        self.visible = True
        self.hitbox = (self.x + 10, self.y, 40, 60)

    def draw(self, win):
        if self.visible:
            self.move()
            pygame.draw.rect(win, (255, 0, 0), (self.x, self.y, self.width, self.height))
            
            # Малювання смужки HP (зелена поверх червоної)
            pygame.draw.rect(win, (255, 0, 0), (self.hitbox[0], self.hitbox[1] - 20, 50, 10))
            pygame.draw.rect(win, (0, 255, 0), (self.hitbox[0], self.hitbox[1] - 20, 5 * self.health, 10))
            
            self.hitbox = (self.x + 10, self.y, 40, 60)

    def move(self):
        if self.vel > 0:
            if self.x + self.vel < self.path[1]:
                self.x += self.vel
            else:
                self.vel = self.vel * -1
        else:
            if self.x - self.vel > self.path[0]:
                self.x += self.vel
            else:
                self.vel = self.vel * -1

    def respawn(self):
        self.x = self.path[0] # Повертаємо гобліна на початкову точку x
        self.health = 10      # Відновлюємо здоров'я до максимуму
        self.visible = True   # Робимо його знову видимим

class Projectile:
    def __init__(self, x, y, radius, color):
        self.x = x
        self.y = y
        self.radius = radius
        self.color = color
        self.vel = 8

    def draw(self, win):
        pygame.draw.circle(win, self.color, (self.x, self.y), self.radius)

def redrawGameWindow():
    win.blit(bg, (0, 0))
    hero.draw(win)
    goblin.draw(win) # Малюємо нашого гобліна
    for bullet in bullets:
        bullet.draw(win)
    pygame.display.update()

hero = Player(225, 410, 60, 60)
goblin = Enemy(50, 410, 60, 60, 450) # Створення об'єкта goblin
bullets = []

run = True
while run:
    pygame.time.delay(30)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            run = False

    for bullet in bullets[:]:
        # Перевірка влучання кулі саме в гобліна
        if goblin.visible:
            if bullet.y - bullet.radius < goblin.hitbox[1] + goblin.hitbox[3] and bullet.y + bullet.radius > goblin.hitbox[1]:
                if bullet.x + bullet.radius > goblin.hitbox[0] and bullet.x - bullet.radius < goblin.hitbox[0] + goblin.hitbox[2]:
                    
                    goblin.health -= 1
                    if bullet in bullets:
                        bullets.remove(bullet)
                    
                    if goblin.health <= 0:
                        goblin.respawn() # Виклик респавну після смерті гобліна

        if bullet.x < 500 and bullet.x > 0:
            bullet.x += bullet.vel
        else:
            if bullet in bullets:
                bullets.remove(bullet)

    keys = pygame.key.get_pressed()
    
    if keys[pygame.K_SPACE]:
        if len(bullets) < 5:
            bullets.append(Projectile(round(hero.x + hero.width // 2), round(hero.y + hero.height // 2), 6, (0, 0, 0)))

    if keys[pygame.K_LEFT] and hero.x > hero.vel:
        hero.x -= hero.vel
    if keys[pygame.K_RIGHT] and hero.x < win_width - hero.width - hero.vel:
        hero.x += hero.vel

    redrawGameWindow()

pygame.quit()
